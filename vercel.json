{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/fetch-rss.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/resumes.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/publications.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/cron-quotidien.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/etat.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/mise-a-jour.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/nettoyage.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/nuage.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/traduire.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/connexion.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/fetch-rss",
      "dest": "/api/fetch-rss.js"
    },
    {
      "src": "/api/resumes",
      "dest": "/api/resumes.js"
    },
    {
      "src": "/api/publications",
      "dest": "/api/publications.js"
    },
    {
      "src": "/api/cron-quotidien",
      "dest": "/api/cron-quotidien.js"
    },
    {
      "src": "/api/etat",
      "dest": "/api/etat.js"
    },
    {
      "src": "/api/mise-a-jour",
      "dest": "/api/mise-a-jour.js"
    },
    {
      "src": "/api/nettoyage",
      "dest": "/api/nettoyage.js"
    },
    {
      "src": "/api/nuage",
      "dest": "/api/nuage.js"
    },
    {
      "src": "/api/traduire",
      "dest": "/api/traduire.js"
    },
    {
      "src": "/api/connexion",
      "dest": "/api/connexion.js"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-quotidien",
      "schedule": "0 23 * * *"
    }
  ]
}